{
  "name": "guess",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "check:deps": "node -e \"const fs=require('fs');if(fs.existsSync('scripts/check-deps.mjs'))process.exit(require('child_process').spawnSync('node',['scripts/check-deps.mjs'],{stdio:'inherit'}).status??1)\"",
    "verify": "pnpm typecheck && pnpm test && pnpm check:deps"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
